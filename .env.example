# AquaSentinal configuration. Reference list only: nothing loads this file, so export the variables in the shell that starts the backend. Never commit real values.

# Meta Model API (server-side only; the browser never sees this key). Leave blank for labelled offline mode.
MODEL_API_KEY=
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_SPARK_MODEL=muse-spark-1.3
META_SAM_MODEL=sam-3.1
META_VOICE_MODEL=muse-voice-transcribe-1.0
# Credit controls (see backend/app/meta/governor.py).
# Process-wide cap in USD on money spent by live Meta calls; a request that could pass it is refused before it is sent. Spend is read from the SQLite execution log, so it survives restarts only on a persistent disk.
AQUA_META_BUDGET_USD=1.00
# Optional. When set, Meta-calling routes need the request header X-Aqua-Passcode with this value; without it they behave as if no key is set (labelled LIVE LOCKED). Never commit a real value.
# Use a long random string of at least 16 characters, for example the output of: openssl rand -hex 12
AQUA_LIVE_PASSCODE=

# Mode and hardware. Hardware stays disabled unless both APP_MODE=HARDWARE and AQUA_HARDWARE_ENABLE=true and a port is set.
APP_MODE=SIMULATION
AQUA_HARDWARE_ENABLE=false
AQUA_SERIAL_PORT=
AQUA_SERIAL_BAUD=115200
AQUA_CAMERA_DEVICE=

# Storage
DATABASE_URL=sqlite:///./aquasentinal.db
AQUA_DATA_DIR=./data

# Backend CORS allowlist and the frontend's backend URL
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# optional full-match pattern for origins not known in advance, e.g. Vercel previews: https://aquasentinal-[a-z0-9-]+-<team-slug>\.vercel\.app
CORS_ORIGIN_REGEX=
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
